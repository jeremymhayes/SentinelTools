# ---- server-side secrets (never NEXT_PUBLIC_, never in the client bundle) ----

# Known-malware-reputation lookup via VirusTotal. The lookup sends the
# SHA-256 hash only — never file contents — and only after the user
# explicitly clicks the lookup button. Server-side only; the UI shows
# "Not configured" when this is unset.
# Get a key: virustotal.com → sign up (free) → profile → API Key.
# Free tier: 4 lookups/minute, 500/day.
# In production set this as a Cloudflare secret: npx wrangler secret put VIRUSTOTAL_API_KEY
VIRUSTOTAL_API_KEY=66b99c603e3e20d17bef8e74e1ca28643ecaa71dbc37c77c6018de995ef8e5b9

# ---- build-time public URLs (inlined into the client bundle) ----
# Local defaults are used when unset: hub :3000, repo :3001, file :3002,
# LinkSentinel :3003. Production values:
NEXT_PUBLIC_HUB_URL=https://sentineltools.net
NEXT_PUBLIC_REPO_URL=https://repo.sentineltools.net
NEXT_PUBLIC_FILE_URL=https://file.sentineltools.net
NEXT_PUBLIC_LINKSENTINEL_URL=https://link.sentineltools.net
